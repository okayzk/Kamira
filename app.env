# The app's identity, in one place. The build writes these into Info.plist and the
# text tables, the scripts read them through scripts/lib.sh, and the code asks the
# bundle (AppInfo.swift). Markdown cannot read a file, so scripts/check_identity.py
# holds the READMEs, the release notes and the docs to these values in `make check`.
#
# Plain KEY="value" lines: shell, Make and Python all read this file.
# The app icon and the menu bar icon are drawn in Sources/App/AppMark.swift, not
# stored here; `make icon` redraws the app icon and the README logo from it.

# Also the executable, the .app, the disk image and the temporary folder, so letters
# and digits only.
NAME="Kamira"
# Changing it after a release resets every user's preferences and permissions.
BUNDLE_ID="io.github.okayzk.Kamira"
# owner/name on GitHub.
REPOSITORY="okayzk/Kamira"
# Three numbers; BUILD goes up by one with every release.
VERSION="0.1.1"
BUILD="2"
# One sentence each, written for its own readers, not translated.
TAGLINE_EN="Catch the screen, keep it light."
TAGLINE_ZH="截得下，放得轻。"
# The notarytool keychain profile on the release machine (scripts/notarize.sh).
NOTARY_KEYCHAIN_PROFILE="kamira-notary"
# The self-signed certificate releases are signed with until there is a Developer ID,
# so that users keep the screen-recording permission across updates
# (scripts/make_release_certificate.sh). Shared by all of the maintainer's apps, so
# its name is not this app's. Never replace it after a release: a new certificate
# makes every user allow screen recording again.
RELEASE_CERTIFICATE="okayzk Code Signing"
RELEASE_CERTIFICATE_SHA1="92E301BCC2AF06E141247AC5DEED2D8883C07C85"
# The public half of the key every update is signed with (scripts/make_update_key.sh).
# Never replace it after a release: users would stop receiving updates.
UPDATE_PUBLIC_KEY="NQQbsyR+hwsDzjArz7Fi02B7HxeD2Lt26IN6db51Mno="
